<script>
    function add(){
        let sum=0;
        // for(let value of arguments){
        //     sum+=value;
        // }
        for (let i in arguments){
            sum += arguments[i];
        }
        document.write(`${sum}<br>`);
    }   
    add(10,20);
    add(10,20,30);
    add(10,20,30,40);
    add(10,20,30,40,50);
    add(10,20,30,40,50,60);
    add(10,20,30,40,50,60,70);
    add(10,20,30,40,50,60,70,80);
</script>
